# ============================================
# Veritas Swarm - Root .gitignore
# ============================================

# ============================================
# Environment & Secrets
# ============================================
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
secrets/
config/secrets.json

# ============================================
# Python
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
.virtualenv/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================
# Node.js / Frontend
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# ============================================
# IDEs & Editors
# ============================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Eclipse
.project
.classpath
.settings/

# NetBeans
nbproject/

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Media & Test Files
# ============================================
# Uploaded test files
uploads/
temp/
tmp/
*.tmp

# Large media files (uncomment if needed)
# *.mp4
# *.avi
# *.mov
# *.mkv
# *.webm
# *.jpg
# *.jpeg
# *.png
# *.gif

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# Build Outputs
# ============================================
build/
dist/
out/
*.bundle.js
*.bundle.js.map

# ============================================
# Documentation Build
# ============================================
docs/_build/
docs/.doctrees/

# ============================================
# Backup Files
# ============================================
*.bak
*.backup
*.old
*.orig

# ============================================
# Compressed Files
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============================================
# AI/ML Specific
# ============================================
# Model files (if you download any)
*.h5
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.pb
models/
checkpoints/

# Datasets
datasets/
data/raw/
data/processed/

# ============================================
# CrewAI Specific
# ============================================
.crewai/

# ============================================
# Project Specific
# ============================================
# Temporary analysis files
backend-adk-agents/temp_*
backend-adk-agents/uploads/

# Test outputs
test_outputs/
test_results/

# Screenshots (if you want to exclude them)
# docs/screenshots/

# ============================================
# Package Manager Lock Files (Optional)
# ============================================
# Uncomment if you want to exclude lock files
